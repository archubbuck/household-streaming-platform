{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "runId", "sessionId", "taskFingerprint", "workflow", "inputs", "timestamp"],
  "properties": {
    "version": { "const": 1 }, "runId": { "type": "string" }, "sessionId": { "type": "string" },
    "taskFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workflow": { "type": "string" }, "inputs": { "type": "object" }, "timestamp": { "type": "string" }
  }
}