{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources", "milestones", "nextActions"],
  "properties": {
    "version": { "const": 1 },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "status"],
      "properties": {
        "requirements": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "outcome", "packages"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-4](-RK)?$" },
          "title": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "packages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "status", "implementation", "verification", "dependencies", "evidence", "blockers"],
              "properties": {
                "id": { "type": "string", "pattern": "^M[0-4](-RK)?-[0-9]{1,2}$|^M[0-4]\\.[0-9]+$" },
                "title": { "type": "string", "minLength": 1 },
                "status": { "enum": ["complete", "in_progress", "blocked", "not_started"] },
                "implementation": { "type": "string", "minLength": 1 },
                "verification": { "enum": ["passed", "partial", "blocked", "not_run", "not_applicable"] },
                "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "note"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "note": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "action"],
        "properties": {
          "packageId": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
