{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "scope", "status", "errorCode", "startedAt", "finishedAt", "observation", "limitations"],
  "properties": {
    "version": { "const": 1 }, "scope": { "const": "tooling-inspection-only" },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "errorCode": { "type": ["string", "null"], "pattern": "^[A-Z_]+$" },
    "startedAt": { "type": "string" }, "finishedAt": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["capabilityId", "status", "reasonCodes", "requiresDeviceForTask", "sdkToolingInstalled", "sdkVersion", "sdkReferenceMatches", "configValid", "officialSkillsPresent", "transport", "actualBackend", "protocolReachable", "mcpToolsAdvertised", "advertisedToolCount", "toolCatalogFingerprint", "mcpToolsCallable", "editorClientCallable", "configuredTarget", "deviceReachable", "physicalValidation"],
      "properties": {
        "capabilityId": { "const": "roku-mcp" }, "status": { "enum": ["degraded", "blocked"] },
        "reasonCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_]+$" } },
        "requiresDeviceForTask": { "type": "boolean" }, "sdkToolingInstalled": { "type": "boolean" },
        "sdkVersion": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "sdkReferenceMatches": { "type": ["boolean", "null"] }, "configValid": { "type": "boolean" },
        "officialSkillsPresent": { "type": "boolean" }, "transport": { "const": "stdio" },
        "actualBackend": { "type": "null" }, "protocolReachable": { "type": ["boolean", "null"] },
        "mcpToolsAdvertised": { "type": ["boolean", "null"] }, "advertisedToolCount": { "type": ["integer", "null"], "minimum": 0 },
        "toolCatalogFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "mcpToolsCallable": { "type": "null" }, "editorClientCallable": { "type": "null" },
        "configuredTarget": { "type": "null" }, "deviceReachable": { "type": "null" }, "physicalValidation": { "const": "blocked" }
      }
    }
  }
}