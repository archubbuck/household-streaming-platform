{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "runId", "sessionId", "taskFingerprint", "workflow", "registryHash", "commitSha", "sourceDigest", "clean", "startedAt", "finishedAt", "checks", "readyForMerge", "artifactHashes", "signature"],
  "properties": {
    "version": { "const": 1 }, "runId": { "type": "string" }, "sessionId": { "type": "string" },
    "taskFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workflow": { "type": "string" }, "registryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commitSha": { "type": ["string", "null"] }, "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "clean": { "type": "boolean" }, "startedAt": { "type": "string" }, "finishedAt": { "type": "string" },
    "readyForMerge": { "type": "boolean" }, "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactHashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "command", "status", "exitCode", "startedAt", "finishedAt", "evidencePath", "reason"],
        "properties": {
          "id": { "type": "string" }, "command": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["passed", "failed", "skipped", "blocked"] },
          "exitCode": { "type": ["integer", "null"] },
          "startedAt": { "type": "string" }, "finishedAt": { "type": "string" },
          "evidencePath": { "type": "string" }, "reason": { "type": "string" }
        }
      }
    }
  }
}