{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": { "const": 1 },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "description", "tags", "entrypoint", "resources", "dependencies", "applicability", "owner", "permissions", "validations", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "type": { "enum": ["agent", "behavior", "workflow", "script", "skill", "template", "schema", "adr", "runbook"] },
          "description": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "entrypoint": { "type": "string", "minLength": 1 },
          "resources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "applicability": {
            "type": "object", "additionalProperties": false, "required": ["always", "keywords"],
            "properties": {
              "always": { "type": "boolean" },
              "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "owner": { "type": "string", "minLength": 1 },
          "permissions": {
            "type": "object", "additionalProperties": false, "required": ["write"],
            "properties": { "write": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
          },
          "validations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "version": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}