{
  "version": 1,
  "capabilities": [
    {
      "id": "experience-api-foundation",
      "type": "script",
      "version": 1,
      "description": "Incomplete NestJS Experience API foundation with scoped Jellyfin catalog access and device pairing; playback remains unavailable.",
      "tags": ["api", "jellyfin", "pairing"],
      "entrypoint": "apps/experience-api/src/main.ts",
      "resources": [
        "apps/experience-api/src/app.ts",
        "apps/experience-api/src/devices.ts",
        "apps/experience-api/src/device-cli.ts",
        "apps/experience-api/src/jellyfin.ts",
        "apps/experience-api/src/mock-jellyfin.ts",
        "apps/experience-api/src/preview-fixtures.ts",
        "apps/experience-api/src/api.test.ts",
        "apps/experience-api/tsconfig.json",
        "apps/experience-api/package.json",
        "docs/api/experience-api.md"
      ],
      "dependencies": ["api", "quality"],
      "applicability": { "always": false, "keywords": ["experience api", "jellyfin", "pairing"] },
      "owner": "api",
      "permissions": { "write": [] },
      "validations": ["registry"]
    }
  ]
}
